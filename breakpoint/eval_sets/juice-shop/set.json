  "variants": {
    "clean": {
      "drop_paths": [
        "README.md",
        "*.md",
        "data/static/challenges.yml",
        "data/static/codefixes/*"
      ],
      "strip_regex": [
        "\\s*(//|#)\\s*vuln-code-snippet.*$"
      ],
      "blank_lines_matching": [
        "^\\s*(//|#)\\s*vuln-code-snippet",
        "challenges\\.\\w+Challenge",
        "challengeUtils\\.solve"
      ]
    }
  }
